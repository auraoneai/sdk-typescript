{
  "name": "@auraone/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "TypeScript SDK for Node.js backends using the hosted AuraOne API, with typed evaluations, authentication, retries, polling, REST, and GraphQL.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "npm run test:unit && npm run test:release",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev",
    "package:test": "node scripts/release/test-package.mjs",
    "release:prepare": "node scripts/release/prepare-release.mjs",
    "release:validate": "node scripts/release/validate-release.mjs",
    "release:preflight": "npm run release:validate && npm run audit:production && npm run typecheck && npm run lint && npm test && npm run build && npm run package:test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:validate",
    "dev": "npm run build:watch"
  },
  "keywords": [
    "auraone",
    "typescript",
    "nodejs",
    "sdk",
    "api-client",
    "hosted-api",
    "ai-evaluation",
    "agent-evaluation",
    "evaluation-api",
    "graphql-client",
    "rest-client"
  ],
  "author": {
    "name": "AuraOne",
    "url": "https://www.auraone.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auraoneai/sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/auraoneai/sdk-typescript/issues"
  },
  "homepage": "https://www.auraone.ai/developers",
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "langchain": "^0.1.0",
    "rollup": "^4.5.0",
    "rollup-plugin-dts": "^6.1.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "cross-fetch": "^4.0.0",
    "qs": "^6.15.3"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  }
}
