{
  "name": "@auraone/sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Official TypeScript SDK for AuraOne API - Comprehensive AI platform for training, analytics, and collaboration",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm exec rollup -c",
    "verify:package-imports": "node scripts/verify-package-imports.mjs",
    "build:watch": "pnpm exec rollup -c -w",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "dev": "npm run build:watch"
  },
  "keywords": [
    "auraone",
    "api",
    "sdk",
    "typescript",
    "ml",
    "ai",
    "training",
    "analytics",
    "collaboration",
    "quality",
    "safety"
  ],
  "author": "AuraOne Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/auraoneai/sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/auraoneai/sdk-typescript/issues"
  },
  "homepage": "https://auraone.ai/open/sdk-typescript",
  "devDependencies": {
    "@langchain/core": "^1.2.9",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rollup": "^4.5.0",
    "rollup-plugin-dts": "^6.1.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "cross-fetch": "^4.0.0",
    "qs": "^6.11.2"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  }
}
